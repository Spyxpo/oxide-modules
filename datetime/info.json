{
  "name": "datetime",
  "version": "0.0.2",
  "description": "Cross-platform date and time module for Oxide. Parse, format, and manipulate dates and times with ease.",
  "author": "Oxide Team",
  "license": "MIT",
  "repository": "https://github.com/Spyxpo/oxide-modules/tree/stable/datetime",
  "homepage": "https://oxide-lang.dev/modules/datetime",
  "tags": ["datetime", "date", "time", "calendar", "timezone", "utilities"],
  "category": "utilities",
  "keywords": ["datetime", "date", "time", "calendar", "timezone", "timestamp", "format", "parse"],
  "platforms": {
    "macos": {
      "supported": true,
      "minVersion": "10.13",
      "dependencies": [],
      "frameworks": []
    },
    "windows": {
      "supported": true,
      "minVersion": "10",
      "dependencies": []
    },
    "linux": {
      "supported": true,
      "dependencies": []
    },
    "ios": {
      "supported": true,
      "minVersion": "12.0"
    },
    "android": {
      "supported": true,
      "minVersion": "21"
    },
    "web": {
      "supported": false
    }
  },
  "main": "src/datetime.ox",
  "native": true,
  "ffi": {
    "enabled": true,
    "libraries": {
      "macos": "liboxide_datetime.dylib",
      "linux": "liboxide_datetime.so",
      "windows": "oxide_datetime.dll"
    },
    "pluginClass": {
      "macos": {
        "name": "OxideDatetimePlugin"
      },
      "linux": {
        "name": "OxideDatetimePlugin"
      },
      "windows": {
        "name": "OxideDatetimePlugin"
      }
    }
  }
}
